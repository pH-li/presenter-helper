# Copy this file to .env and fill in your values. .env is git-ignored.
#
# Supabase: find these under Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / "public" key. It is safe to expose in the browser as long as
# row-level security (RLS) is enabled on your tables.
SUPABASE_ANON_KEY=your-anon-key

# Do NOT put the service_role key here or anywhere in the frontend.
# It bypasses row-level security.
