# Copy this file to .env and fill in your values. .env is git-ignored.
# `npm start` reads it and writes public/config.js.
# On Netlify, set the same variables under Project configuration → Environment variables.
#
# Supabase: find these under Project Settings → API (or API Keys).
SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" or "publishable" (sb_publishable_…) key. It's safe in the browser
# because row-level security limits each user to their own rows.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# NEVER use the service_role / secret (sb_secret_…) key here. It bypasses
# row-level security. scripts/write-config.js refuses to build with it.
